extends layout

block content
  h1= title
  p Welcome to #{title}
  ol
  each val in todos
    li
      span(class='task-name')= val.task
      span  - 

      if val.completed > 0
        span Completed
      else
        span Not Completed

      form(method='POST' action='/delete')
        input(class='task-id', type='hidden', name='id', value=val.id)
        button(type='submit') Delete
      
      button(class='edit-btn') Edit

  hr
  h2 Add a new task
  form(method='POST' action='/create')
    label(for='task') Task:
    input(type='text', name='task', id='task', required)
    button(type='submit') Create Task
