extends layout

block content
  h1= title
  div(class="interface-container")
    div
      each val in todos
        div(class="task-container")
          input(class='task-id', type='hidden', name='id', value=val.id)

          if val.completed
            input(type='checkbox' class='completion-toggle' checked)
            span(class='task-name completed')= val.task
          else
            input(type='checkbox' class='completion-toggle')
            span(class='task-name')= val.task

          br

          button(class='delete-btn') Delete
          button(class='edit-btn') Edit

    div
      h2 Add a new task
      form(method='POST' action='/create')
        input(type='text', name='task', id='task', required)
        br
        button(type='submit') Create Task
